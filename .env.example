# SecureCompilerAI Environment Configuration Example

# Backend Settings
PROJECT_NAME="SecureCompilerAI"
VERSION="1.0.0"
API_V1_STR="/api"
PORT=8000
HOST="127.0.0.1"

# SQLite Database
DATABASE_URL="sqlite:///./secure_compiler.db"

# Execution Security & Limits
MAX_FILE_SIZE_BYTES=2097152
EXECUTION_TIMEOUT_SECONDS=5

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

